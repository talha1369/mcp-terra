.pip-cache/
node_modules/

# Claude Code machine-local state — do NOT commit (records per-machine
# permission grants + command history; noise/leak risk in a public repo).
# NOTE: .claude/skills/ IS part of the project and is intentionally tracked.
.claude/settings.local.json
